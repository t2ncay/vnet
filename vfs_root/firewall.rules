# VEKTRA FIREWALL RULESET v4.2
# Generated by d34d_7dp on 2026-09-08

*filter
:INPUT DROP [0:0]
:FORWARD DROP [0:0]
:OUTPUT ACCEPT [0:0]

# Allow established connections
-A INPUT -m state --state ESTABLISHED,RELATED -j ACCEPT

# Allow SSH (Port 22)
-A INPUT -p tcp --dport 22 -j ACCEPT

# Allow VNET Protocol (Port 8001)
-A INPUT -p udp --dport 8001 -j ACCEPT

# Allow HTTP/HTTPS for terminal.vnet
-A INPUT -p tcp --dport 80 -s 10.0.0.0/24 -j ACCEPT
-A INPUT -p tcp --dport 443 -s 10.0.0.0/24 -j ACCEPT

# Rate limiting for ICMP (Ping)
-A INPUT -p icmp -m limit --limit 1/second -j ACCEPT
-A INPUT -p icmp -j DROP

# Log dropped packets
-A INPUT -j LOG --log-prefix "FIREWALL-DROP: " --log-level 4

COMMIT